# Copy this to /etc/ismiseeanna-mcp.env on the VM (setup.sh does this
# automatically on first run) and fill in the real values. chmod 600 it -
# it holds your Garmin password.

# The Garmin token cache lives under $HOME (see garmin_client.py); point it
# at the dedicated service account's home directory rather than a real user's.
HOME=/var/lib/ismiseeanna-mcp

MCP_TRANSPORT=streamable-http
# Caddy reverse-proxies to this from 443; keep the app itself off the public
# interface.
MCP_HOST=127.0.0.1
PORT=8000

# Your WorkOS AuthKit project domain (Connect -> Configuration).
WORKOS_AUTHKIT_DOMAIN=https://REPLACE-WITH-YOUR-AUTHKIT-DOMAIN.authkit.app
# Must exactly match this deployment's public URL and the resource indicator
# registered in WorkOS.
MCP_RESOURCE_URL=https://REPLACE-WITH-YOUR-HOSTNAME/mcp

# Only needed for the very first login - remove both once a session token is
# cached (systemctl restart ismiseeanna-mcp after removing them).
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password
