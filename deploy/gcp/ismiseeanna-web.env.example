# Copy this to /etc/ismiseeanna-web.env on the VM (setup.sh does this
# automatically on first run) and fill in the real values. chmod 600 it -
# it holds the key that decrypts every connected user's Garmin session.

# MUST be the exact same values as the matching lines in ismiseeanna-mcp.env
# - this process reads/writes the identical per-user Garmin token store as
# the MCP server (see garmin_client.py). A mismatch here doesn't error, it
# just silently makes a Garmin connection made on one surface invisible on
# the other.
HOME=/var/lib/ismiseeanna-mcp
TOKEN_ENCRYPTION_KEY=REPLACE-WITH-THE-SAME-KEY-AS-ismiseeanna-mcp.env

# Caddy reverse-proxies to this from 443; keep the app itself off the public
# interface.
WEB_HOST=127.0.0.1
PORT=8001

# A WorkOS "regular web app" Application - Applications -> Create
# Application -> Redirect URI: https://REPLACE-WITH-YOUR-APP-HOSTNAME/callback
# - in the SAME WorkOS project/environment as the MCP connector's AuthKit
# domain, but a separate client from the MCP resource-server's own
# auto-registered one.
WORKOS_API_KEY=REPLACE-WITH-YOUR-WORKOS-API-KEY
WORKOS_CLIENT_ID=REPLACE-WITH-YOUR-WORKOS-CLIENT-ID
WEB_REDIRECT_URI=https://REPLACE-WITH-YOUR-APP-HOSTNAME/callback

# Seals the session cookie (WorkOS's sealed-session pattern). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WORKOS_COOKIE_PASSWORD=REPLACE-WITH-A-GENERATED-SECRET-AT-LEAST-32-BYTES
